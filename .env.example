# Server-only model settings
ANALYSIS_PROVIDER=deepseek
ANALYSIS_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
# Neon Postgres connection supplied by the Vercel integration
DATABASE_URL=
# GitHub OAuth; callback https://YOUR-DOMAIN/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Generate locally: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=
# Stable numeric GitHub user id of the operator; never an unverified email
OPERATOR_GITHUB_ID=
# Shared maximum provider calls per UTC day, including repairs and translations
MODEL_DAILY_CALL_LIMIT=100
# Optional owner-only operator login; generate at least 32 random characters
OPERATOR_ACCESS_KEY=
